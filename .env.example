# ==============================================================================
# BillCraft Invoice Generator — Environment Configuration Example
# Copy this file to .env.local for local development.
# ==============================================================================

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (leave empty or default for offline mock demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email (Resend)
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM_ADDRESS=invoices@yourdomain.com

# Node Environment
NODE_ENV=development
