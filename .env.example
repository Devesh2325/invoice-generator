# ==============================================================================
# BillCraft Invoice Generator — Environment Configuration Example
# Copy this file to .env.local for local development.
# ==============================================================================

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (leave empty or default for offline mock demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Appwrite Backend Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=invoxa_main
NEXT_PUBLIC_APPWRITE_BUCKET_ID=invoxa_assets
APPWRITE_API_KEY=your-appwrite-api-secret-key

# Transactional Email (Resend)
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM_ADDRESS=invoices@yourdomain.com

# Super Admin sign-in (server only: never add a NEXT_PUBLIC_ prefix)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=choose-a-long-unique-password
# Random value of at least 32 characters that signs admin sessions
ADMIN_SESSION_SECRET=generate-a-long-random-value

# Node Environment
NODE_ENV=development
